# ===== Токен бота =====
BOT_TOKEN=your_bot_token_here

# ===== Група та топік =====
GROUP_CHAT_ID=-1001234567890
THREAD_ID=123

# ===== Відповідальні та адміни (через кому, без пробілів) =====
RESPONSIBLE_USER_IDS=111111111,222222222
ADMIN_USER_IDS=333333333

# ===== Розклад дедлайнів =====
WEEKDAY_DEADLINES=11:00,14:00,17:00,20:00
WEEKEND_DEADLINES=11:00,12:00,18:00

# ===== Час нагадувань до дедлайну (хвилини) =====
PRE_REMIND_MINUTES=60
FINAL_REMIND_MINUTES=30

# ===== true — вихідні повністю пропускаються =====
WORKDAYS_ONLY=false

# ===== Таймзона =====
TIMEZONE=Europe/Kyiv
